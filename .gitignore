# monkeyc build output. Everything here is regenerated by ./tools/build.sh, and a
# stale debug .prg in this folder is actively dangerous: it is ~105 KB, which does not
# fit the fenix6s watch-face memory pool, under the exact filename the docs tell you to
# copy onto a watch.
build/

# Developer signing key. Never commit this. It lives outside the project, at
# ~/.Garmin/ConnectIQ/developer_key.der, and tools/build.sh reads it from there.
*.der
*.pem
*.key
